{
	"name": "powereditor",
	"version": "1.52.6",
	"description": "Obsidian plugin: format any note from a toolbar, selection bubble, or slash menu, with everything staying plain Markdown",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node predeploy.mjs && node deploy.mjs",
		"predeploy": "node predeploy.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.110.0"
	},
	"devDependencies": {
		"@codemirror/language": "^6.10.0",
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.26.3",
		"@types/node": "^20.14.0",
		"esbuild": "^0.21.5",
		"obsidian": "latest",
		"tslib": "^2.6.3",
		"typescript": "^5.5.3"
	}
}
