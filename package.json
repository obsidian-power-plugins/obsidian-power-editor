{
	"name": "powereditor",
	"version": "1.59.4",
	"description": "Obsidian plugin: format any note from a toolbar, selection bubble, or slash menu, with everything staying plain Markdown",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node predeploy.mjs && node deploy.mjs",
		"predeploy": "node predeploy.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.110.0"
	},
	"devDependencies": {
		"@codemirror/language": "6.12.4",
		"@codemirror/state": "6.7.1",
		"@codemirror/view": "6.43.6",
		"@types/node": "20.19.43",
		"esbuild": "0.21.5",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
